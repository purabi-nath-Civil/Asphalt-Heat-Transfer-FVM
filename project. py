import numpy as np
import matplotlib.pyplot as plt

# Parameters
L = 1.0 # Length of rod
Nx = 100 # Number of grid points
dx = L / (Nx - 1)
alpha = 0.01 # Thermal diffusivity
dt = 0.001 # Time step
t_final = 1.0 # Final time

x = np.linspace(0, L, Nx)
T = np.ones(Nx) * 300 # Initial temperature 300K
T[0] = 500 # Hot end 500K
T[-1] = 300 # Cold end 300K

n_steps = int(t_final / dt)

for n in range(n_steps):
    Tn = T.copy()
    for i in range(1, Nx-1):
        T[i] = Tn[i] + alpha * dt / dx**2 * (Tn[i+1] - 2*Tn[i] + Tn[i-1])

plt.figure(figsize=(8,6))
plt.plot(x, T, label=f'Time = {t_final}s', color='red')
plt.xlabel('Position (m)')
plt.ylabel('Temperature (K)')
plt.title('1D Heat Transfer Simulation - By Purabi Nath')
plt.legend()
plt.grid(True)
plt.savefig('heat_transfer.png')
print("Graph saved as heat_transfer.png")